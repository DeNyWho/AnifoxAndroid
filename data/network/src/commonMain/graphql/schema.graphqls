type Anime {
  """
  Color derived from image color
  """
  accentColor: String!

  airedOn: DateTime

  animeListEntry(userId: String): AnimeListEntry

  """
  User comments on anime
  """
  comments(limit: Int = 30, page: Int = 0): AnimeCommentConnection!

  createdAt: DateTime!

  description: String

  duration: Float

  """
  Anime episodes
  """
  episodes(limit: Int = 30, page: Int = 0): EpisodeConnection!

  episodesAired: Int!

  episodesCount: Int

  franchise: String

  """
  Anime genres
  """
  genres: [AnimeGenre!]!

  """
  Anime ID
  """
  id: ID!

  image: AnimeImage!

  """
  Minimal age to view anime
  """
  minimalAge: Int!

  """
  Next episode release date
  """
  nextEpisode: DateTime

  """
  Link for Kodik player iframe
  """
  playerLink: String!

  """
  Средний рейтинг аниме
  """
  rating: Float!

  """
  Кол-во оценок аниме
  """
  ratingCount: Int!

  """
  Age limit for view in MPAA format
  """
  ratingMpa: String!

  """
  Related animes
  """
  related(limit: Int = 30, page: Int = 0): AnimeConnection!

  """
  Anime release date
  """
  releasedOn: DateTime!

  screenshots: [String!]!

  season: AnimeSeason!

  """
  Anime ID on shikimori
  """
  shikimoriId: Int!

  """
  Anime rating on shikimori
  """
  shikimoriRating: Float!

  """
  Anime votes count on shikimori
  """
  shikimoriVotes: Int!

  """
  Similar animes
  """
  similar(limit: Int = 30, page: Int = 0): AnimeConnection!

  status: AnimeStatus!

  studios: [AnimeStudio!]!

  """
  Anime title
  """
  title: String!

  titlesEnglish: [String!]!

  titlesJapan: [String!]!

  titlesOther: [String!]!

  titlesSynonyms: [String!]!

  type: AnimeType!

  """
  Date of last anime update (any data)
  """
  updatedAt: DateTime

  """
  Unique anime url derived from anime title
  """
  url: String!

  userRating(userId: String): AnimeRating

  videos: [AnimeVideo!]!

  """
  Year of release
  """
  year: Int!
}

