type Login {
  tokens: UserTokens!

  user: User!
}

type Mutation {
  acceptFriendInvite(friendshipId: ID!): Friendship!

  addFriend("ID пользователя, который получит заявку в друзья" friendId: ID!): Friendship!

  changePassword(currentPassword: String!, newPassword: String!): Boolean!

  confirmPasswordReset(code: String!, email: String!, newPassword: String!): Boolean!

  createAnimeComment(animeId: String!, html: String!, json: String!, "ID комментария, на который пользователь отвечает" parentCommentId: String, text: String!): AnimeComment!

  login(identifier: String!, password: String!): Login!

  refreshTokens(refreshToken: String!): UserTokens!

  rejectFriendInvite(friendshipId: ID!): Friendship!

  removeAnimeComment(id: String!): AnimeComment!

  removeAnimeListEntry(animeUrl: String!): AnimeListEntry!

  removeAnimeRating(animeId: String!): AnimeRating!

  removeFriend(friendshipId: ID!): Friendship!

  removeUserAbout: UserAbout!

  requestPasswordReset(email: String!): Boolean!

  saveAnimeListEntry(animeUrl: String!, endedAt: DateTime, episodesWatched: Int, startedAt: DateTime, status: AnimeListStatus = WATCHING): AnimeListEntry!

  saveAnimeRating("Anime ID for rating" animeId: String!, rating: Int!): AnimeRating!

  saveEpisodeProgress(animeId: String!, episodeId: String!, "Текущее время просмотра в секундах" timing: Int!): EpisodeProgress!

  saveLastWatchedEpisode(animeId: String!, "ID эпизода, который должен быть сохранен" episodeId: String!, "ID озвучки, который должна быть сохранена" translationId: Int!): LastWatchedEpisode!

  saveUser(birthday: DateTime, login: String, name: String): User!

  saveUserAbout(html: String!, json: JSON!, text: String!): UserAbout!

  """
  Запрос для установки длительности серии через kodik
  """
  setEpisodeDuration("Длительность эпизода в минутах" duration: Int!, episodeId: String!): Episode!

  signup(avatar: String, banner: String, birthday: DateTime, email: String!, login: String!, name: String!, password: String!): Signup!

  toggleAnimeCommentDislike(animeCommentId: String!): AnimeCommentDislike!

  toggleAnimeCommentLike(animeCommentId: String!): AnimeCommentLike!

  toggleFavoriteAnime(animeUrl: String!): FavoriteAnime!

  toggleFavoriteCharacter(characterId: String!): FavoriteCharacter!

  updateAnimeComment(commentId: String!, html: String!, json: String!, text: String!, "Поле для редактирования верификации комментария (Доступно только для роли модератор и выше)" verified: Boolean): AnimeComment!

  updateUserLastSeen: User!
}

type PageInfo {
  hasNextPage: Boolean!

  hasPreviousPage: Boolean!

  limit: Int!

  page: Int!

  totalCount: Int!

  totalPages: Int!
}

type Query {
  anime(url: String!): Anime!

  animeComment(id: String!): AnimeComment!

  animeCommentDislikes(animeCommentId: String, limit: Int = 30, page: Int = 0): AnimeCommentDislikeConnection!

  animeCommentLikes(animeCommentId: String, limit: Int = 30, page: Int = 0): AnimeCommentLikeConnection!

  animeComments(animeId: String, limit: Int = 30, page: Int = 0, userId: String): AnimeCommentConnection!

  animeFranchise(id: String!): AnimeFranchise!

  animeFranchises(limit: Int = 30, page: Int = 0): AnimeFranchiseConnection!

  animeList("Фильтр по статусу, если ничего не передано - вернет весь список" status: AnimeListStatus, "ID юзера, чей список нужно получить" userId: String!): AnimeList!

  animeRating(animeId: String!, userId: String!): AnimeRating!

  animeRatingDistribution(animeId: String!): AnimeRatingDistribution!

  animeSchedules("Фильтр по дню недели" dayOfWeek: DayOfWeek): [AnimeSchedule!]!

  animeYears: AnimeYears!

  animes(genres: [String!], limit: Int = 30, minimalAge: Int, order: AnimeOrder, page: Int = 0, ratingMpa: RatingMpa, search: String, season: AnimeSeason, sort: SortOrder, status: AnimeStatus, "Filter anime by studios" studios: [String!], translations: [Int!], type: AnimeType, "Filter anime by year of release" years: [Int!]): AnimeConnection!

  character(id: String, malId: Int): Character!

  characters("Filter characters only for provided animeUrl" animeUrl: String, limit: Int = 30, page: Int = 0, "Filter by character role" role: CharacterRole, "Filter by character name" search: String): CharacterConnection!

  checkEmailExist(email: String!): Boolean!

  checkLoginExist(login: String!): Boolean!

  episode(episodeId: String!): Episode!

  episodeProgress(animeId: String!, episodeId: String!, userId: String!): EpisodeProgress!

  episodeTranslations(episodeId: String!): [EpisodeTranslation!]!

  episodes("Выборка эпизодов для конкретного аниме" animeUrl: String!, limit: Int = 30, order: EpisodeOrder = NUMBER, page: Int = 0, sort: SortOrder = ASC): EpisodeConnection!

  episodesHistory(animeUrl: String!): [EpisodeHistory!]!

  favoriteAnimes(limit: Int = 30, page: Int = 0, userId: String!): FavoriteAnimeConnection!

  favoriteCharacters(limit: Int = 30, page: Int = 0, userId: String!): FavoriteCharacterConnection!

  friendships(limit: Int = 30, page: Int = 0, "Поиск по имени друга" search: String, "Фильтр по статусу дружбы" status: FriendshipStatus! = ACCEPTED, "ID пользователя, чьих друзей нужно получить" userId: String!): FriendshipsConnection!

  genre: AnimeGenre!

  genres: [AnimeGenre!]!

  lastWatchedEpisode(animeId: String!, userId: String!): LastWatchedEpisode

  lastWatchedEpisodes(limit: Int = 30, page: Int = 0, userId: String!): LastWatchedEpisodeConnection

  profile(login: String!): User!

  randomAnimes(count: Int = 10): [Anime!]!

  relatedAnimes(animeId: String!, limit: Int = 30, page: Int = 0): RelatedAnimeConnection!

  similarAnimes(animeId: String!, limit: Int = 30, page: Int = 0): AnimeConnection!

  studio(id: String!): AnimeStudio!

  studios: [AnimeStudio!]!

  translations: [Translation!]!

  user(id: String!): User!

  userStatistics(userId: String!): UserStatistics!

  users(limit: Int = 30, page: Int = 0, "Поиск по имени или логину пользователя" search: String): UserConnection!

  viewer: User!
}

